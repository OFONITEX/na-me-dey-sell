# ========================================================
# Nà Mè Dèy Sell — Monnify Payment Gateway Configuration
# ========================================================
# You can use the same API Key and Contract Code from your existing Monnify account!
# Transactions from this platform are automatically prefixed with 'NMDS-TXN-...'
# so they will never clash with your other platform.

# Your Monnify API Key (from Monnify Dashboard -> Settings -> API Keys)
NEXT_PUBLIC_MONNIFY_API_KEY=your_monnify_api_key_here

# Your Monnify Contract Code (from Monnify Dashboard)
NEXT_PUBLIC_MONNIFY_CONTRACT_CODE=your_monnify_contract_code_here

# Set to true for test/sandbox mode, false for live payments
NEXT_PUBLIC_MONNIFY_IS_SANDBOX=false
